# Builds the vendored Abseil (libs/abseil-cpp) as static libraries linked into
# flakewm. C++ code in the compositor logs through absl/log.

set(ABSL_PROPAGATE_CXX_STD ON CACHE BOOL "" FORCE)
set(ABSL_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(ABSL_BUILD_TESTING OFF CACHE BOOL "" FORCE)

add_subdirectory(
  "${PROJECT_SOURCE_DIR}/libs/abseil-cpp"
  "${PROJECT_BINARY_DIR}/libs/abseil-cpp"
  EXCLUDE_FROM_ALL
)
