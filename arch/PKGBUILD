# Maintainer: CharOfString <root@charofstring.cc>
pkgbase=flakewm
pkgname=('flakewm' 'flakewm-client' 'gxde-flake-session')
pkgver=3.0.6
pkgrel=7
pkgdesc='GXDE Wayland compositor'
arch=('x86_64' 'aarch64')
url="https://github.com/flake-wm/flake-wm"
license=('GPL-1.0-or-later' 'GPL-2.0-or-later' 'GPL-3.0-or-later' 'LGPL-2.1-or-later' 'MIT' 'MIT-CMU'
         'MulanPSL-2.0' 'BSD-3-Clause')

makedepends=('git' 'cmake' 'ninja' 'meson' 'pkgconf' 'gettext' 'glslang' 'hwdata' 'systemd' 'vulkan-headers'
             'wayland-protocols' 'qt6-base' 'qt6-declarative' 'qt6-5compat' 'cairo' 'glib2' 'json-c'
             'libdisplay-info' 'libdrm' 'libepoxy' 'libglvnd' 'libinput' 'libjpeg-turbo' 'libliftoff' 'libpng'
             'librsvg' 'libei' 'libunwind' 'libxcb' 'libxkbcommon' 'mesa' 'openssl' 'pango' 'pixman' 'readline' 're2'
             'seatd' 'vulkan-icd-loader' 'wayland' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm'
             'xorg-xwayland')
source=()
sha512sums=()

_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWLCOM_EXAMPLES=OFF \
    -DWLCOM_UKUI_THEME=ON \
    -DWLCOM_WLROOTS_RENDERERS=gles2,vulkan
  ninja -C build
  DESTDIR="$srcdir/root" ninja -C build install
}

_pick() {
  local _f
  cd "$srcdir/root"
  for _f in "$@"; do
    [[ -e $_f || -L $_f ]] || { echo "missing: $_f" >&2; return 1; }
    install -d "$pkgdir/$(dirname "$_f")"
    mv "$_f" "$pkgdir/$_f"
  done
}

package_flakewm() {
  depends=('cairo' 'glib2' 'json-c' 'libdisplay-info' 'libdrm' 'libepoxy' 'libglvnd' 'libinput'
           'libjpeg-turbo' 'libliftoff' 'libpng' 'librsvg' 'libei' 'libunwind' 'libxcb' 'libxkbcommon' 'mesa'
           'openssl' 'pango' 'pixman' 'seatd' 'systemd-libs' 'vulkan-icd-loader' 'wayland' 'xcb-util-errors'
           'xcb-util-renderutil' 'xcb-util-wm' 'xorg-xwayland' 'libgcc' 'libstdc++' 'glibc'
           'readline' 're2')
  provides=("flakewm-git=$pkgver")
  conflicts=('flakewm-git')
  replaces=('flakewm-git')

  _pick usr/bin/flakewm usr/bin/flakectl usr/share/locale usr/share/flakewm usr/lib/udev/rules.d etc/flakewm \
        usr/share/glib-2.0/schemas
  [[ ! -d usr/lib/flakewm ]] || _pick usr/lib/flakewm
  install -Dm644 "$(_srcroot)/data/configs/OMG.conf" "$pkgdir/etc/flakewm/OMG.conf"
  install -Dm644 "$(_srcroot)"/LICENSES/{MIT-CMU,MulanPSL-2.0}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$(_srcroot)/tools/flakectl/hyprland/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.hyprland"
  install -Dm644 "$(_srcroot)/tools/flakectl/hyprutils/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.hyprutils"
  install -Dm644 "$(_srcroot)/NOTICE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_flakewm-client() {
  pkgdesc='Client library of the GXDE Wayland compositor'
  depends=('wayland' 'libgcc' 'libstdc++' 'glibc')
  provides=("flakewm-client-git=$pkgver")
  conflicts=('flakewm-client-git')
  replaces=('flakewm-client-git')

  cd "$srcdir/root"
  _pick usr/lib/libflakewm-client.so* usr/include usr/lib/pkgconfig
}

package_gxde-flake-session() {
  pkgdesc='GXDE session on the Flake Wayland compositor'
  depends=("flakewm=$pkgver-$pkgrel" 'bash')
  provides=("gxde-flake-session-git=$pkgver")
  conflicts=('gxde-flake-session-git')
  replaces=('gxde-flake-session-git')

  _pick usr/bin/startflakewm usr/share/wayland-sessions/gxde-flakewm.desktop
}
