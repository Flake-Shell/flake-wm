# As FlakeWM graduatelly migrates to C++ from C, we are now enforcing Google
# Styled C++ guidelines.
# However, all C source codes and vendored libraries are NOT affected.
---
Language: Cpp
BasedOnStyle: Google

# Loop-like macros, so they are laid out as loops rather than calls.
ForEachMacros:
  - 'wl_list_for_each'
  - 'wl_list_for_each_safe'
  - 'wl_list_for_each_reverse'
  - 'wl_list_for_each_reverse_safe'
  - 'wl_array_for_each'
  - 'wl_resource_for_each'
  - 'wl_resource_for_each_safe'
  - 'json_object_object_foreach'
  - 'xorg_list_for_each_entry'
  - 'xorg_list_for_each_entry_safe'
  - 'udev_list_entry_foreach'
  - 'hash_table_for_each'
---
Language: C
DisableFormat: true
