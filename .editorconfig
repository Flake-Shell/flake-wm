# As FlakeWM graduatelly migrates to C++ from C, we are now enforcing Google
# Styled C++ guidelines.
# However, all C source codes and vendored libraries are NOT affected.

root = true

# .h is C, except for the C++ headers listed here (also in .clang-format-ignore)
[{**.cc,**.cpp,src/c_compact.h,src/misc/**.h,src/util/kywc_log_sink.h,src/shell/gxde/kwin_shim/**.h}]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

[{libs,src/vendor,examples/gui,tools/flakectl/hyprland,tools/flakectl/hyprutils}/**]
charset = unset
end_of_line = unset
indent_size = unset
indent_style = unset
insert_final_newline = unset
max_line_length = unset
trim_trailing_whitespace = unset
